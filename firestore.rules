rules_version = '2';

// =============================================================================
// Mysuru Paakashale — Firestore Security Rules
//
// Division of responsibility: these rules decide WHO can read/write WHAT —
// authorization, plus a few high-value data checks (price integrity,
// state-machine transitions, "which fields actually changed"). This app
// has no Cloud Functions in its live architecture (Spark plan, client SDK
// only — see PRODUCTION_READINESS_REPORT.md); these rules ARE the entire
// write-path validation, not a backstop for one. Full shape/format
// validation for anything not checked here lives in Zod schemas on the
// client, which is necessarily advisory, not enforced — treat any
// high-value field (price, status, amount) as something that belongs in
// this file, checked explicitly, not just assumed from the client.
//
// SPRINT 4 CHANGES:
//   - payments: customers may create their own 'pending' payment claim
//     (manual payment verification workflow — see paymentService.ts);
//     only isAdmin() may verify/reject (update) or delete
//   - notifications: expanded to support the full Notification type;
//     client can mark read (inAppStatus) and archive (inAppStatus = archived)
//     — both are guarded by onlyChangedFields to prevent other tampering
//   - subscriptions: customer self-updates are restricted to an explicit
//     allow-list of status transitions (was: any value, same fields) —
//     closes a free-self-activation gap, see isAllowedCustomerTransition()
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      // Phase 3: Read role from Firestore instead of Custom Claims
      let userDoc = isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)) : null;
      return (userDoc != null) ? userDoc.data.get('role', null) : null;
    }

    function isAdmin() { return role() == 'admin'; }
    function isCustomer() { return role() == 'customer'; }
    function isKitchen() { return role() == 'kitchen'; }
    function isDeliveryPartner() { return role() == 'delivery_partner'; }
    function isAccounts() { return role() == 'accounts'; }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function onlyChangedFields(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------- users/{userId} ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isAccounts() || 
                     (isSignedIn() && resource.data.get('role', null) == 'delivery_partner') ||
                     (isSignedIn() && resource.data.get('deliveryPartnerId', null) == request.auth.uid);

      // Phase 2: Client-side user creation allowed for customers
      // Phase 9: Admin can create staff users directly from the client
      allow create: if (isOwner(userId) && request.resource.data.role == 'customer') || isAdmin();

      // Owner may update their own profile, but never their own role or
      // id (that would be a privilege escalation) — role changes only
      // ever happen through createStaffUser. Delivery assignments are Admin only.
      allow update: if (isOwner(userId) && 
                        unchanged('role') && 
                        unchanged('id') &&
                        unchanged('deliveryPartnerId') &&
                        unchanged('assignedAt') &&
                        unchanged('assignedBy')) || isAdmin();

      // Staff are deactivated (isActive: false), never deleted — this
      // preserves order/invoice/audit history that references their uid.
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- userPhones/{phone} ----------
    // Phone number uniqueness registry. Read access is restricted to
    // signed-in users only — allowing unauthenticated reads enables
    // phone-number enumeration attacks (OWASP A01/IDOR).
    match /userPhones/{phone} {
      allow read: if isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if (isSignedIn() && resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- mealPlans/{planId} — public catalog ----------
    match /mealPlans/{planId} {
      // No auth required: prospective customers browse pricing before signing up.
      allow read: if true;
      allow write: if isAdmin() &&
                      request.resource.data.pricePerDay is number &&
                      request.resource.data.pricePerDay > 0;
    }

    // ---------- dailyMenus/{menuId} ----------
    match /dailyMenus/{menuId} {
      // Published menus are public marketing content. Draft and archived
      // menus contain internal planning information and are staff-only.
      allow read: if resource.data.status == 'published' || isAdmin() || isKitchen();

      // Admin has full write access.
      // Kitchen can create and edit draft menus directly.
      // Publishing/archiving goes through the manageDailyMenu Cloud Function.
      allow create: if isAdmin() || (isKitchen() && request.resource.data.status == 'draft');
      allow update: if isAdmin() || (isKitchen() && resource.data.status == 'draft' && request.resource.data.status == 'draft');
      allow delete: if isAdmin() || (isKitchen() && resource.data.status == 'draft');
    }

    // ---------- kitchens/{kitchenId} ----------
    match /kitchens/{kitchenId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- deliveryZones/{zoneId} ----------
    match /deliveryZones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- subscriptions/{subscriptionId} ----------
    match /subscriptions/{subscriptionId} {
      // Customers can only move their own subscription along the exact
      // transitions the UI exposes — never straight to 'active' from
      // anything but 'paused'. That specifically blocks a customer from
      // writing { status: 'active' } directly via the SDK to skip payment
      // verification entirely (a subscription can otherwise only become
      // 'active' through admin/payment approval).
      function isOwnSubscription() {
        return isSignedIn() && resource.data.customerId == request.auth.uid;
      }
      function isAllowedCustomerTransition() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        return (from == 'active' && to == 'paused') ||
               (from == 'paused' && to == 'active') ||
               (from == 'active' && to == 'cancelled') ||
               (from == 'paused' && to == 'cancelled') ||
               ((from == 'cancelled' || from == 'expired') && to == 'pending_payment');
      }

      function isValidSkipCredit() {
        let diff = request.resource.data.creditBalance - resource.data.creditBalance;
        let expectedCredit = resource.data.pricePerDaySnapshot * (resource.data.get('quantity', 1));
        return diff == expectedCredit;
      }

      allow read: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid || isAdmin() || isAccounts() || isKitchen());

      // Phase 5: Admins can create/update subscriptions, customers can create pending drafts
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'pending_payment');

      // Phase 5: Admins have full access; customers are limited to isAllowedCustomerTransition() above.
      // Customers can also increment their creditBalance by their daily price when skipping a delivery.
      allow update: if isAdmin() ||
                       (isOwnSubscription() && onlyChangedFields(['status', 'updatedAt']) && isAllowedCustomerTransition()) ||
                       (isOwnSubscription() && onlyChangedFields(['creditBalance']) && isValidSkipCredit());

      allow delete: if false; // cancel via status update — preserves billing history

      match /skips/{date} {
        function parentSubscription() {
          return get(/databases/$(database)/documents/subscriptions/$(subscriptionId)).data;
        }

        allow read: if isSignedIn() &&
                       (parentSubscription().customerId == request.auth.uid || isAdmin() || isKitchen());
        allow create: if isSignedIn() && parentSubscription().customerId == request.auth.uid;
        allow update: if false; // a skip is added or removed, never edited in place
        allow delete: if isSignedIn() && parentSubscription().customerId == request.auth.uid; // "un-skip" a day
      }
    }

    // ---------- dailyProductionStates/{date} ----------
    match /dailyProductionStates/{date} {
      allow read: if isSignedIn();
      
      // Admins only. If day is closed, it's immutable EXCEPT for Reopen Day (changing status back to 'open')
      allow create: if isAdmin();
      allow update: if isAdmin() && 
                      (resource.data.status != 'closed' || 
                       (resource.data.status == 'closed' && request.resource.data.status == 'open'));
      allow delete: if false;
    }

    // ---------- orders/{orderId} ----------
    match /orders/{orderId} {
      // Helper: Daily status lookup performs one document read per write.
      // This is highly acceptable and performant for the current ERP scale.
      // Note: Larger deployments may require backend-mediated writes or caching optimizations.
      function getDayStatus(dateStr) {
        let path = /databases/$(database)/documents/dailyProductionStates/$(dateStr);
        return exists(path) ? get(path).data.status : 'open';
      }

      function isValidDeliveryTransition(oldStatus, newStatus) {
        return (oldStatus == 'ready_for_pickup' && newStatus == 'picked_up') ||
               (oldStatus == 'picked_up' && newStatus == 'out_for_delivery') ||
               (oldStatus == 'out_for_delivery' && (newStatus == 'delivered' || newStatus == 'failed_delivery' || newStatus == 'returned_delivery'));
      }

      // Kitchen status transition guard: only forward movement within the
      // kitchen lane is permitted. Prevents kitchen staff from jumping
      // an order to 'delivered' or any billing/delivery state.
      function isValidKitchenTransition(oldStatus, newStatus) {
        return (oldStatus == 'scheduled' && newStatus == 'preparing') ||
               (oldStatus == 'preparing' && newStatus == 'ready_for_pickup');
      }


      allow read: if isSignedIn() &&
                      (resource.data.get('customerId', null) == request.auth.uid ||
                       resource.data.get('deliveryPartnerId', null) == request.auth.uid ||
                      isAdmin() || isAccounts() || isKitchen());

      // Phase 4: Admins can generate orders
      // Customers can create one-time trial orders
      allow create: if isAdmin() || 
                      (isSignedIn() && 
                       request.resource.data.customerId == request.auth.uid && 
                       request.resource.data.source == 'one_time' &&
                       request.resource.data.status == 'scheduled');

      // Each role can move status forward within its own lane:
      //  - Kitchen: scheduled → preparing → ready_for_pickup (explicit transitions)
      //  - Delivery Partner (their own assigned order): ready_for_pickup → picked_up → out_for_delivery → delivered / failed_delivery
      //  - Customer (their own order, still 'scheduled'): → cancelled
      //  - Admin: anything
      allow update: if isAdmin() ||
                      (isKitchen() && onlyChangedFields(['status', 'updatedAt']) && 
                       isValidKitchenTransition(resource.data.status, request.resource.data.status) &&
                       getDayStatus(resource.data.date) == 'open') ||
                      (isDeliveryPartner() && resource.data.deliveryPartnerId == request.auth.uid &&
                       onlyChangedFields(['status', 'updatedAt', 'deliveryResult', 'deliveryNotes']) && 
                       isValidDeliveryTransition(resource.data.status, request.resource.data.status) &&
                       getDayStatus(resource.data.date) != 'closed') ||
                      (isSignedIn() && resource.data.customerId == request.auth.uid &&
                       resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled' &&
                       onlyChangedFields(['status', 'updatedAt']) && 
                       getDayStatus(resource.data.date) == 'open');

      allow delete: if false;

      match /workflowHistory/{historyId} {
        allow read: if isSignedIn() &&
                       (get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
                        get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPartnerId == request.auth.uid ||
                        isAdmin() || isAccounts() || isKitchen());
        allow create: if isSignedIn() && request.resource.data.changedBy == request.auth.uid &&
                         (isAdmin() || isKitchen() || isDeliveryPartner() ||
                          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid);
        allow update, delete: if false; // append-only history
      }
    }

    // ---------- deliveries/{deliveryId} ----------
    match /deliveries/{deliveryId} {
      allow read: if isSignedIn() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.deliveryPartnerId == request.auth.uid ||
                      isAdmin() || isKitchen());

      // Admin/System only writes
      allow write: if isAdmin();
    }

    // ---------- dailyDeliveryStates/{date} ----------
    match /dailyDeliveryStates/{date} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      
      match /driverSessions/{driverId} {
        allow read: if isSignedIn();
        // Driver can only update their own session
        allow write: if isAdmin() || (isDeliveryPartner() && request.auth.uid == driverId);
      }
    }

    // ---------- payments/{paymentId} ----------
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || isAccounts());
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin() || isAccounts());
      allow write: if isAdmin(); // Phase 6: Invoice generation by admin transactions
    }

    // ---------- notifications/{notificationId} ----------
    // Created only by Cloud Functions (Admin SDK). Recipients may:
    //   - read their own notifications
    //   - mark as read (inAppStatus: unread → read, status: read, readAt)
    //   - archive (inAppStatus: archived, status: archived)
    // Admins may read all notifications (for history page).
    match /notifications/{notificationId} {
      // Customers can trigger a narrow set of "I did something, tell the
      // admins" notifications (e.g. submitting a payment) — never
      // arbitrary type/recipient/content, which would otherwise let any
      // signed-in customer spam or impersonate system notifications to
      // any other user.
      function isCustomerTriggerableNotification() {
        return request.resource.data.createdBy == request.auth.uid &&
               (request.resource.data.recipientId == request.auth.uid ||
                get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'admin') &&
               request.resource.data.type in ['payment_submitted', 'subscription_created', 'subscription_pending_payment'];
      }

      allow read: if isSignedIn() &&
                     (resource.data.recipientId == request.auth.uid || isAdmin());

      allow create: if isAdmin() || (isSignedIn() && isCustomerTriggerableNotification());

      // Recipient may only change inAppStatus, status, and readAt fields.
      // Admins can't update via client either — management goes through Cloud Functions.
      allow update: if isSignedIn() &&
                       resource.data.recipientId == request.auth.uid &&
                       onlyChangedFields(['inAppStatus', 'status', 'readAt', 'updatedAt']);

      // Physical delete not allowed — archive instead for audit trail.
      allow delete: if false;
    }

    match /orderGenerationRuns/{runId} {
      allow read: if isKitchen() || isAdmin();
      allow write: if isAdmin(); // Phase 4: Manual order generation via Admin UI
    }

    // ---------- inventory/{itemId} ----------
    match /inventory/{itemId} {
      allow read: if isKitchen() || isAdmin();
      allow write: if isKitchen() || isAdmin();
    }

    match /settings/userCounters {
      // Allow any signed-in user to read and increment the user ID counter.
      // This is required for client-side sign-up (since we don't have Cloud Functions).
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      // Settings may contain internal configuration (pricing, cutoff times,
      // zone config).
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Phase 1: Settings updated by admin
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Allow any authenticated user to create an audit log for their own
      // actions, but restrict the writable fields to prevent content injection.
      allow create: if isSignedIn() &&
                       request.resource.data.actorId == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['actorId', 'actorName', 'actorRole', 'action', 'entityType', 'entityId', 'timestamp', 'details', 'ipAddress', 'sessionId']);
      allow update, delete: if false; // Audit logs must be immutable
    }

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Phase 8: Automations
    }

    // ---------- feedback/{feedbackId} ----------
    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- HR Module (Phase 2) ----------
    match /attendance/{recordId} {
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin() || isAccounts());
      // Staff may only create attendance records for themselves (staffId must equal auth.uid).
      // Prevents one staff member from creating records for another.
      allow create: if isAdmin() || isAccounts() ||
                       (isSignedIn() && request.resource.data.staffId == request.auth.uid);
      allow update: if isAdmin() || isAccounts() ||
                       (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow delete: if isAdmin() || isAccounts();
    }
    match /leaves/{leaveId} {
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin() || isAccounts());
      // Staff may only submit leave requests for themselves.
      allow create: if isAdmin() || isAccounts() ||
                       (isSignedIn() && request.resource.data.staffId == request.auth.uid);
      allow update: if isAdmin() || isAccounts() ||
                       (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow delete: if isAdmin() || isAccounts();
    }
    match /payroll/{payrollId} {
      allow read: if isSignedIn() && (resource.data.staffId == request.auth.uid || isAdmin() || isAccounts());
      allow write: if isAdmin() || isAccounts();
    }
    match /salaryProfiles/{profileId} {
      allow read: if isSignedIn() && (profileId == request.auth.uid || isAdmin() || isAccounts());
      allow write: if isAdmin() || isAccounts();
    }

    // No catch-all rule: anything not matched above is denied by default.
  }
}
