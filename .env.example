# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real Firebase/Razorpay keys.
#
# Get the Firebase values from: Firebase Console → Project settings →
# General → Your apps → (Web app) → SDK setup and configuration.
# These are all PUBLIC client identifiers, not secrets — Firestore/Storage
# security rules are what actually protect your data, not hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key — Firebase Console → Project settings → Cloud
# Messaging → Web configuration → Generate key pair. Only needed once you
# wire up push notifications (Phase: Notifications).
VITE_FIREBASE_VAPID_KEY=


# Set to "true" to point the app at the local Firebase Emulator Suite
# (see README.md "Local development"). Leave unset/blank to use your real
# Firebase project.
VITE_USE_FIREBASE_EMULATORS=


# ── Automation / GitHub Actions ─────────────────────────────────────────────
# Service account for the scheduled GitHub Actions workflows (daily.yml,
# weekly.yml, monthly.yml). Create a dedicated Firebase Auth user with the
# 'admin' role for this purpose — never reuse a personal account.
#
# Add both values as GitHub Actions secrets in:
# Repository → Settings → Secrets and variables → Actions → New repository secret
#
# For local script runs:  copy these into .env.local alongside the Firebase keys.
VITE_AUTOMATION_EMAIL=
VITE_AUTOMATION_PASSWORD=
