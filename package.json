{
  "name": "mysuru-paakashale-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:security": "vitest run --test-timeout=30000 --config vitest.int.config.ts tests/security/firestore.security.test.ts tests/security/storage.security.test.ts tests/security/unskip.security.test.ts tests/security/orderHistory.security.test.ts tests/security/hr.security.test.ts tests/security/subscriptions.security.test.ts tests/security/idor.test.ts tests/security/replay.test.ts tests/security/xss.test.ts tests/security/kitchenE2E.test.ts",
    "test:functions": "vitest run --test-timeout=30000 --config vitest.int.config.ts tests/security/cancellation-function.int.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "db:wipe": "vite-node scripts/wipeUserData.ts",
    "db:seed-plans": "vite-node scripts/seedPlans.ts",
    "emulators:start": "firebase emulators:start --project demo-test --export-on-exit=./emulator-data --import=./emulator-data"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
