rules_version = '2';

// =============================================================================
// Mysuru Paakashale — Cloud Storage Security Rules
//
// Uses cross-service rules (firestore.get) to check delivery-proof upload
// permission against the actual Firestore `deliveries` document. The first
// deploy of rules using firestore.get()/firestore.exists() prompts you (in
// the Firebase Console or CLI) to grant Storage permission to read
// Firestore — see README.md "Deploying rules". Cross-service checks are
// capped at 2 Firestore document reads per rules evaluation; every path
// below uses at most one.
//
// PHASE 4 SECURITY HARDENING CHANGES:
//   - profile-photos: restrict reads to owner + admin only (was: any signed-in user)
//     prevents customers from enumerating other users' profile images.
//   - delivery-proof: restrict kitchen read access (kitchen can read; accounts cannot)
//   - payment-screenshots: no change (owner + admin + accounts)
//   - backups/reports: added explicit admin-only guard (no change needed, confirming)
//   - All upload paths: enforce image/* MIME type + 5 MB limit consistently
//   - meal-plan-images: public read is intentional (marketing images); admin write only
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Image upload guard: enforces content type and size limit.
    // maxMb should be a plain number (e.g. 5 for 5 MB).
    function isImageUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // PDF upload guard: for payment receipts that may be PDFs.
    function isPdfOrImageUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
          && (request.resource.contentType.matches('image/.*')
              || request.resource.contentType == 'application/pdf');
    }

    function getUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth.token.role == 'admin' || getUser().role == 'admin';
    }

    function isKitchen() {
      return request.auth.token.role == 'kitchen' || getUser().role == 'kitchen';
    }

    function isAccounts() {
      return request.auth.token.role == 'accounts' || getUser().role == 'accounts';
    }

    function isDeliveryPartner() {
      return request.auth.token.role == 'delivery_partner' || getUser().role == 'delivery_partner';
    }

    // /profile-photos/{userId}/{fileName}
    // SECURITY FIX: read was previously open to any signed-in user, enabling
    // enumeration of profile images for any known UID. Restrict to owner + admin.
    match /profile-photos/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isImageUnder(5);
    }

    // /delivery-proof/{deliveryId}/{fileName}
    // Write: only the assigned delivery partner may upload proof photos.
    // Read:  customer (their own delivery), delivery partner, admin, kitchen.
    //        Accounts cannot view delivery proof photos (not in their operational scope).
    // NOTE: The app uses the `orders` collection for delivery tracking — there
    //        is no separate `deliveries` collection. The deliveryId path param
    //        corresponds to the orderId in the `orders` collection.
    match /delivery-proof/{deliveryId}/{fileName} {
      function deliveryOrder() {
        return firestore.get(/databases/(default)/documents/orders/$(deliveryId)).data;
      }

      allow read: if isSignedIn() &&
                     (deliveryOrder().customerId == request.auth.uid ||
                      deliveryOrder().deliveryPartnerId == request.auth.uid ||
                      isAdmin() || isKitchen());

      // Only the assigned delivery partner may upload; image only, 5 MB max.
      allow write: if isSignedIn()
                   && deliveryOrder().deliveryPartnerId == request.auth.uid
                   && isImageUnder(5);
    }

    // /meal-plan-images/{planId}/{fileName}
    // Public read is intentional — these are marketing catalog images shown
    // before authentication (prospective customers browsing plan pricing).
    match /meal-plan-images/{planId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin() && isImageUnder(5);
    }

    // /backups/{fileName} — Automated database backups. Admin only.
    match /backups/{fileName} {
      allow read, write: if isSignedIn() && isAdmin();
    }

    // /reports/{fileName} — Automated Excel/PDF reports. Admin + Accounts.
    match /reports/{fileName} {
      allow read: if isSignedIn() && (isAdmin() || isAccounts());
      allow write: if isSignedIn() && (isAdmin() || isAccounts());
    }

    // /payment-screenshots/{userId}/{fileName}
    // Customers upload payment screenshots for manual verification.
    // Accounts staff and admins can view for verification; delivery/kitchen cannot.
    match /payment-screenshots/{userId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isAccounts());
      // Accept images and PDFs (some payment receipts come as PDFs).
      // Restrict to 5 MB max.
      allow write: if isSignedIn() && request.auth.uid == userId && isPdfOrImageUnder(5);
    }

    // Everything else: denied by default (no catch-all rule needed —
    // Firebase Storage denies unmatched paths automatically).
  }
}

// Trigger deploy
