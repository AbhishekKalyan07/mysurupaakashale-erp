{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.int.tsbuildinfo",
    "composite": true,
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node", "vite/client", "vite-plugin-pwa/client", "vitest/globals"],
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases (mirrors resolve.alias in vite.config.ts) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Relaxed linting for test files */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.int.config.ts",
    "vitest.int.setup.ts",
    "functions/src/**/*.ts"
  ]
}
